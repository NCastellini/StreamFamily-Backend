# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio.

# Puerto del servidor (en Render lo asigna la plataforma)
PORT=3000

# development | production | test
NODE_ENV=development

# Origen(es) permitidos por CORS en producción, separados por coma.
# Ej: https://streamfamily-frontend.onrender.com,https://otro-dominio.com
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los JWT. En producción: mínimo 32 caracteres aleatorios.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio